{
    "name": "elvin-qulizade/filament-versions",
    "description": "Snapshot-based version history and restore for Filament resources",
    "keywords": [
        "Elvin-Qulizade",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-versions"
    ],
    "homepage": "https://github.com/elvin-qulizade/filament-versions",
    "support": {
        "issues": "https://github.com/elvin-qulizade/filament-versions/issues",
        "source": "https://github.com/elvin-qulizade/filament-versions"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Elvin-Qulizade",
            "email": "equluzade00@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^4.1",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "ElvinQulizade\\Versions\\": "src/",
            "ElvinQulizade\\Versions\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElvinQulizade\\Versions\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest --no-coverage",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElvinQulizade\\Versions\\VersionsServiceProvider"
            ],
            "aliases": {
                "Versions": "ElvinQulizade\\Versions\\Facades\\Versions"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}